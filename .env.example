# Copiar como .env y completar con las credenciales de Neon (Dashboard > Connection string).
# El archivo .env esta ignorado por git: las credenciales nunca se suben al repositorio.
SPRING_PROFILES_ACTIVE=neon
DB_URL=jdbc:postgresql://ep-XXXX-XXXX.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=
